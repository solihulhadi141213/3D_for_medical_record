# ========================================
# Pharmix - Git Ignore
# Tujuan:
# - aman untuk di-clone
# - mencegah file sensitif/hasil generate ikut ter-commit
# - tetap mempertahankan source code utama
# ========================================

# Dependencies yang bisa dipasang ulang
/node_modules/
/vendor/

# File environment / override lokal
.env
.env.*
!.env.example
!.env.sample

# Konfigurasi lokal yang biasanya berisi kredensial
*_local.php
*.local.php
_Config/*local*.php
_Config/*secret*.php

# Backup database dan dump data
# /db/*
# !/db/.gitkeep
# *.sql
# *.sql.gz
# *.dump
# *.bak
# *.backup
# *.sqlite
# *.sqlite3

# Upload / file hasil generate milik user
/assets/img/User/*
!/assets/img/User/.gitkeep
/assets/upload/*
/uploads/*
/upload/*
/storage/*
!/storage/.gitkeep

# Cache dan file runtime
/cache/
/tmp/
/logs/
*.log
*.cache
*.tmp

# Sertifikat / key / secret file
*.key
*.pem
*.p12
*.pfx
*.crt
*.csr

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editor files
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# Package manager / lockfile caches yang tidak diperlukan untuk source
npm-debug.log*
yarn-debug.log*
yarn-error.log*
